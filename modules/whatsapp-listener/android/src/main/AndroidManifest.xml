<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Android starts this service once the user grants notification access. It only keeps WhatsApp notifications. -->
    <service
      android:name="expo.modules.whatsapplistener.WhatsAppNotificationService"
      android:label="NotToday WhatsApp scanner"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
